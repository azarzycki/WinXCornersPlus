<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the app assembly (WinXCornersPlus) only, from the Windows platform tests. Reported, not gated:
     the UI is covered by the separate UI test suite. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[WinXCornersPlus]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
