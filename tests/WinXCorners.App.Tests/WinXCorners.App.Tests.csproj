<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests of the app's platform layer and startup sequence. They run on the Windows CI images
       (ci.yml, job app-tests); on Linux the project only compiles (EnableWindowsTargeting). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinXCorners.App.Tests</AssemblyName>
    <RootNamespace>WinXCorners.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Bounded blocking waits on worker threads (always with a timeout) are what these tests are about. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinXCorners.App\WinXCorners.App.csproj" />
    <ProjectReference Include="..\..\src\WinXCorners.Core\WinXCorners.Core.csproj" />
  </ItemGroup>

</Project>
